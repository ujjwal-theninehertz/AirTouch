<?xml version="1.0" encoding="utf-8"?>
<!-- Window-state events identify the foreground app for per-app profiles. Window content (view boxes and IDs,
     never text) is read only when an action needs it: the cursor's magnet and YouTube's player. Interactive
     windows let the magnet find buttons in the keyboard and the notification shade too. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.airtouch.ui.MainActivity" />
